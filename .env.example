# Branche Neon "demo" (chaîne poolée)
DATABASE_URL=
# Branche Neon "test" (tests d'intégration uniquement)
DATABASE_URL_TEST=
# Neon Auth de la branche "demo"
NEON_AUTH_BASE_URL=
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# "true" pour la démo
DEMO_MODE=true
# Mot de passe commun des comptes de démo (12 caractères minimum)
DEMO_PASSWORD=
# Neon Object Storage, branche "demo" (bucket privé des cartes étudiantes)
# Ne pas utiliser les noms AWS_* : Vercel les réserve.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=student-cards
